{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-hover)"
          }
        }
      },
      "button": {
        "border": {
          "radius": "50px"
        },
        "typography": {
          "fontWeight": "600"
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/post-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "lineHeight": "1.15",
          "fontWeight": "600"
        }
      },
      "core/post-excerpt": {
        "typography": {
          "lineHeight": "1.6"
        }
      }
    }
  },
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "primary",
          "name": "Primary Green",
          "color": "#22412f"
        },
        {
          "slug": "primary-hover",
          "name": "Primary Hover",
          "color": "#2f5c42"
        },
        {
          "slug": "dark",
          "name": "Dark Green Black",
          "color": "#16281d"
        },
        {
          "slug": "accent",
          "name": "Accent Amber",
          "color": "#c98a3b"
        },
        {
          "slug": "background",
          "name": "Cream",
          "color": "#f6f2ea"
        },
        {
          "slug": "contrast",
          "name": "Charcoal",
          "color": "#1c1917"
        },
        {
          "slug": "base",
          "name": "White",
          "color": "#ffffff"
        },
        {
          "slug": "border",
          "name": "Warm Border",
          "color": "#e5dfd3"
        },
        {
          "slug": "text-muted",
          "name": "Muted Text",
          "color": "#5c554d"
        },
        {
          "slug": "text-light-muted",
          "name": "Light Muted Text",
          "color": "rgba(255,255,255,0.72)"
        }
      ]
    },
		"layout": {
			"contentSize": "1440px",
			"wideSize": "1440px"
		},
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "Tiny",
          "size": "10px",
          "slug": "tiny"
        },
        {
          "name": "X-Small",
          "size": "20px",
          "slug": "x-small"
        },
        {
          "name": "Small",
          "size": "30px",
          "slug": "small"
        },
        {
          "name": "Regular",
          "size": "clamp(30px, 5vw, 50px)",
          "slug": "regular"
        },
        {
          "name": "Large",
          "size": "clamp(40px, 7vw, 80px)",
          "slug": "large"
        },
        {
          "name": "X-Large",
          "size": "clamp(50px, 8vw, 110px)",
          "slug": "x-large"
        }
      ],
      "units": ["%", "px", "em", "rem", "vh", "vw"]
    },
    "typography": {
      "writingMode": true,
      "defaultFontSizes": false,
      "fluid": true,
      "fontSizes": [
        {
          "fluid": false,
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          },
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "fluid": {
            "min": "1.125rem",
            "max": "1.375rem"
          },
          "name": "Large",
          "size": "1.125rem",
          "slug": "large"
        },
        {
          "fluid": {
            "min": "1.5rem",
            "max": "2rem"
          },
          "name": "Extra Large",
          "size": "1.5rem",
          "slug": "x-large"
        },
        {
          "fluid": {
            "min": "2rem",
            "max": "3rem"
          },
          "name": "Extra Extra Large",
          "size": "2rem",
          "slug": "xx-large"
        },
        {
          "fluid": {
            "min": "2.5rem",
            "max": "4rem"
          },
          "name": "Hero",
          "size": "2.5rem",
          "slug": "hero"
        }
      ],
      "fontFamilies": [
        {
          "name": "Fraunces",
          "slug": "heading",
          "fontFamily": "'Fraunces', Georgia, serif",
          "fontFace": [
            {
              "src": ["file:./assets/fonts/fraunces-var.woff2"],
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontFamily": "Fraunces"
            }
          ]
        },
        {
          "name": "Inter",
          "slug": "body",
          "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
          "fontFace": [
            {
              "src": ["file:./assets/fonts/inter-var.woff2"],
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontFamily": "Inter"
            }
          ]
        }
      ]
    }
  }
}
